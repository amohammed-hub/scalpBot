# Allow build scripts for native packages (esbuild, tailwindcss oxide)
# Fixes ERR_PNPM_IGNORED_BUILDS in CI/CD deployment
manage-package-manager-versions=true
ignore-workspace-root-check=true
ignore-build-scripts=false
# Disable minimum release age policy (pnpm 10.34 rejects packages published <24h ago)
minimum-release-age=0
